# Optional: required only for Passmark AI frontend tests.
# Recommended for this repo: OpenAI CUA mode.
OPENAI_API_KEY=

# Alternative: use one AI gateway key for Passmark snapshot mode.
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=

# Alternative: use direct provider keys for Passmark multi-model consensus.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional target URL override.
BASE_URL=https://www.creai.mx

# Hide optional Redis/cache warnings from Passmark when Redis is not configured.
PASSMARK_LOG_LEVEL=error
